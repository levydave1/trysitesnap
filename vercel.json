{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/overture-leads",
      "destination": "/api/02-email-preview-test?pipeline=overture"
    },
    {
      "source": "/api/overture-enrichment",
      "destination": "/api/02-email-preview-test?pipeline=enrichment"
    },
    {
      "source": "/api/lead-dashboard",
      "destination": "/api/02-email-preview-test?pipeline=dashboard"
    }
  ],
  "headers": [
    {
      "source": "/lead-dashboard",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "functions": {
    "api/1c177b7f64d64fa9a9a4dce318d8d681-stripe-events.js": {
      "maxDuration": 60
    },
    "api/b066e90394264c16ad9ee7e09d682844-website-leads.js": {
      "maxDuration": 60
    },
    "api/6f09f89b1e644c79ae3aa7210f8f2ff7-outscraper-results.js": {
      "maxDuration": 300
    },
    "api/02-export-email-to-instantly.js": {
      "maxDuration": 300
    },
    "api/02-export-email-to-instantly-winter.js": {
      "maxDuration": 300
    },
    "api/02-email-preview-test.js": {
      "maxDuration": 300
    },
    "api/04-first-sketch.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/02-export-email-to-instantly",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/02-export-email-to-instantly-winter",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/02-export-email-to-instantly-winter?watchdog=1",
      "schedule": "0 11 * * *"
    }
  ]
}
